// Staycation — data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseKind {
  Apartment
  Hotel
  Villa
  Home
}

enum BookingStatus {
  Upcoming
  AwaitingPayment
  Completed
  Cancelled
}

enum PaymentMethod {
  Card
  VirtualAccount
  Midtrans
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Expired
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String   @default("")
  city             String   @default("")
  memberSince      String   @default("2027")
  bio              String   @default("")
  avatarUrl        String?
  preferredStyles  String[] @default([])
  preferredCities  String[] @default([])
  budgetBand       String   @default("$50 – $200")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings Booking[]
}

model Host {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String
  address String

  houses House[]
}

model House {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  city        String
  country     String
  kind        HouseKind
  price       Int
  rating      Float
  reviews     Int
  visitors    String
  bed         Int
  bath        Int
  living      Int
  dining      Int
  wifi        Int
  tv          Int
  tags        String[]
  lead        String
  description String[]
  popular     Boolean   @default(false)

  hostId String
  host   Host   @relation(fields: [hostId], references: [id])

  stories  Story[]
  bookings Booking[]

  createdAt DateTime @default(now())
}

model Story {
  id        String   @id @default(cuid())
  authorName String
  role       String
  rating     Float
  quote      String
  detail     String
  stayedAt   String

  houseId String
  house   House  @relation(fields: [houseId], references: [id])

  createdAt DateTime @default(now())
}

model Booking {
  id           String        @id @default(cuid())
  ref          String        @unique
  checkIn      DateTime
  checkOut     DateTime
  guests       String
  status       BookingStatus @default(Upcoming)
  cancelReason String        @default("")

  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String

  userId String
  user   User   @relation(fields: [userId], references: [id])
  houseId String
  house   House  @relation(fields: [houseId], references: [id])

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id     String        @id @default(cuid())
  method PaymentMethod
  status PaymentStatus @default(Pending)

  amountSub   Int
  amountTax   Int
  amountTotal Int

  cardBrand String?
  cardLast4 String?

  vaBank    String?
  vaNumber  String?
  vaExpiry  DateTime?

  midtransOrderId       String? @unique
  midtransTransactionId String?
  midtransSnapToken     String?
  midtransRedirectUrl   String?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
